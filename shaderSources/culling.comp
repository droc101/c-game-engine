#version 460

#include "shared.inc.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    uint frustumIndex;
} pushConstants;

layout(set = 1, binding = 0, scalar) readonly restrict buffer Frustums {
    Frustum frustums[];
} frustums;

layout(set = 1, binding = 1, scalar) readonly buffer CullInfos {
    uint count;
    CullingInfo cullInfo[];
} cullInfos[8];
layout(set = 1, binding = 1, scalar) readonly buffer ModelActorCullInfos {
    uint count;
    ModelActorCullingInfo cullInfo[];
} modelActorCullInfos[8];

layout(set = 1, binding = 2, scalar) readonly buffer UnculledDrawInfo {
    VkDrawIndexedIndirectCommand drawInfos[];
} unculledDrawInfo[8];
layout(set = 1, binding = 2, scalar) writeonly buffer InstanceIndices {
    uint instanceIndex[];
} instanceIndices[8];

layout(set = 1, binding = 3, scalar) buffer MapModelsDrawInfo {
    uint drawCount;
    VkDrawIndexedIndirectCommand drawInfos[];
} mapModelsDrawInfo[8];
layout(set = 1, binding = 3, scalar) buffer VkDrawIndirectCommand {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} actorWallsDrawInfo[8];
layout(set = 1, binding = 3, scalar) buffer ModelActorsDrawInfo {
    DrawActorModelIndexedIndirectCommand drawInfos[];
} modelActorsDrawInfo[8];

bool IsVisible(const vec3 position, const float radius) {
    if (pushConstants.frustumIndex == -1) {
        const vec3 center = (camera.viewMatrix * vec4(position, 1)).xyz;
        return center.z + radius > camera.nearPlane && center.z - radius < camera.farPlane &&
               center.z * camera.frustumPlanes[1] - abs(center.x) * camera.frustumPlanes[0] > -radius &&
               center.z * camera.frustumPlanes[3] - abs(center.y) * camera.frustumPlanes[2] > -radius;
    }

    // TODO: light frustums are broken
    return true;

    const Frustum frustum = frustums.frustums[pushConstants.frustumIndex];
    const vec3 center = (frustum.viewMatrix * vec4(position, 1)).xyz;
    return center.z + radius > frustum.nearPlane && center.z - radius < frustum.farPlane &&
           center.z * frustum.frustumPlanes[1] - abs(center.x) * frustum.frustumPlanes[0] > -radius &&
           center.z * frustum.frustumPlanes[3] - abs(center.y) * frustum.frustumPlanes[2] > -radius;
}

void CullMapModel(const uint bufferIndex, const uint index) {
    if (IsVisible(cullInfos[bufferIndex].cullInfo[index].position, cullInfos[bufferIndex].cullInfo[index].radius)) {
        const uint drawIndex = atomicAdd(mapModelsDrawInfo[bufferIndex].drawCount, 1);
        mapModelsDrawInfo[bufferIndex].drawInfos[drawIndex] = unculledDrawInfo[bufferIndex].drawInfos[index];
    }
}

void CullWallActor(const uint bufferIndex, const uint index) {
    if (IsVisible(cullInfos[bufferIndex].cullInfo[index].position, cullInfos[bufferIndex].cullInfo[index].radius)) {
        const uint drawIndex = atomicAdd(actorWallsDrawInfo[bufferIndex].instanceCount, 1);
        if (bufferIndex == 4) {
            instanceIndices[4].instanceIndex[drawIndex] = index;
        } else {
            instanceIndices[5].instanceIndex[drawIndex] = index + cullInfos[4].count;
        }
    }
}

void CullModelActor(const uint bufferIndex, const uint index) {
    const uint drawInfoIndex = modelActorCullInfos[bufferIndex].cullInfo[index].drawInfoIndex;
    const uint instanceIndex = atomicAdd(modelActorsDrawInfo[bufferIndex].drawInfos[drawInfoIndex].instanceIndex, bufferIndex == 7 ? -1 : 1);
    if (IsVisible(modelActorCullInfos[bufferIndex].cullInfo[index].position, modelActorCullInfos[bufferIndex].cullInfo[index].radius)) {
        const uint drawIndex = atomicAdd(modelActorsDrawInfo[bufferIndex].drawInfos[drawInfoIndex].instanceCount, 1);
        const uint firstInstance = modelActorsDrawInfo[bufferIndex].drawInfos[drawInfoIndex].firstInstance;
        instanceIndices[bufferIndex].instanceIndex[drawIndex + firstInstance] = instanceIndex + firstInstance;
    }
}

void main() {
    const uint bufferIndex = gl_GlobalInvocationID.y;
    const uint index = gl_GlobalInvocationID.x;
    if (index >= cullInfos[bufferIndex].count) {
        return;
    }

    if (bufferIndex < 4) {
        CullMapModel(bufferIndex, index);
    } else if (bufferIndex < 6) {
        CullWallActor(bufferIndex, index);
    } else {
        CullModelActor(bufferIndex, index);
    }
}