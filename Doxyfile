CREATE_SUBDIRS = YES
OUTPUT_DIRECTORY = doxygen
FULL_PATH_NAMES = NO
STRIP_FROM_PATH = engine/include/engine/
OPTIMIZE_OUTPUT_FOR_C = YES
MARKDOWN_SUPPORT = NO
TOC_INCLUDE_HEADINGS = 0
INLINE_SIMPLE_STRUCTS = YES
