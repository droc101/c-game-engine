				  DEFAULT_*_PLANE\
				  VIEWMODEL_*_Z\
				  DEF_WIDTH\
				  DEF_HEIGHT\
				  MIN_WIDTH\
				  MIN_HEIGHT\
				  MAX_WIDTH\
				  MAX_HEIGHT\
				  LOW_FPS_MODE_SLEEP_MS\
				  MAX_FONTS\
				  MAX_MAP_MATERIALS\
				  MAX_MODELS\
				  MAX_TEXTURES\
				  MAX_LIGHT_COUNT\
				  MAX_ACTORS\
				  MAX_RECOGNIZED_MOUSE_BUTTONS\
				  SOUND_SYSTEM_CHANNEL_COUNT\
				  _ListData
USE_MDFILE_AS_MAINPAGE = README.md

VERBATIM_HEADERS = NO

ALPHABETICAL_INDEX = NO

GENERATE_HTML = YES
HTML_DYNAMIC_SECTIONS = YES
HTML_PROJECT_COOKIE = c-game-engine
ENUM_VALUES_PER_LINE = 1
SHOW_ENUM_VALUES = YES

GENERATE_LATEX = NO

MACRO_EXPANSION = YES
EXPAND_ONLY_PREDEF = YES
