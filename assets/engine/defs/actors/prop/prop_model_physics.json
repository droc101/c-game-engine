{
  "extends": "generic_model_prop",
  "description": "An arbitrary model with physics",
  "renderers": [
    {
      "type": "point",
      "color": "$color",
      "viewport_mode": "2d"
    },
    {
      "type": "orientation",
      "color": "$color",
      "viewport_mode": "2d"
    },
    {
      "type": "model",
      "model": "$model",
      "color": "$color",
      "mod_color": "$color",
      "skin": "$skin"
    }
  ],
  "params": {
    "allow_pickup": {
      "display": "Allow Pickup",
      "type": "bool",
      "default": true,
      "description": "Whether the player should be allowed to pick up this actor"
    },
    "mass_override": {
      "display": "Mass Override",
      "type":"float",
      "minimum": 0.0,
      "default": 0.0,
      "description": "How much mass this actor should have. Set to zero to autocalculate based on the model."
    }
  }
}