{
  "description": "Performs numerical comparison logic",
  "extends": "actor",
  "renderers": [
    {
      "type": "point",
      "color": "#FFFF00"
    }
  ],
  "inputs": {
    "operand_a": {
      "types": [
        "byte",
        "int",
        "float",
        "uint64"
      ],
      "description": "Set operand A for the next execution"
    },
    "operand_b": {
      "types": [
        "byte",
        "int",
        "float",
        "uint64"
      ],
      "description": "Set operand B for the next execution"
    },
    "execute": {
      "description": "Perform a comparison"
    }
  },
  "outputs": {
    "on_true": {
      "description": "Emitted when the result of the execution was true"
    },
    "on_false": {
      "description": "Emitted when the result of the execution was false"
    },
    "execution_result": {
      "type": "bool",
      "description": "Emitted when the \"execute\" input is received. Param contains the result of the execution."
    }
  },
  "params": {
    "operation": {
      "display": "Operation",
      "default": "=",
      "type": "byte",
      "options": "decimal_operation",
      "description": "The operation this logic_decimal performs"
    },
    "operand_a": {
      "display": "Initial Operand A",
      "type": "float",
      "description": "Initial value for operand A"
    },
    "operand_b": {
      "display": "Initial Operand B",
      "type": "float",
      "description": "Initial value for operand B"
    }
  }
}