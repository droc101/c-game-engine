{
  "description": "A coin the player can collect",
  "extends": "actor",
  "renderers": [
    {
      "type": "point",
      "viewport_mode": "2d"
    },
    {
      "type": "orientation",
      "viewport_mode": "2d"
    },
    {
      "type": "wall",
      "width": 4.0,
      "height": 4.0,
      "texture": "texture/actor/coin.gtex",
      "uv_scale_x": 1.0,
      "uv_scale_y": 4.0,
      "uv_offset_x": 0.0,
      "viewport_mode": "3d"
    }
  ],
  "outputs": {
    "collected": {
      "description": "Emitted when this coin is collected by the player"
    }
  },
  "params": {
    "is_blue": {
      "display": "Coin Type",
      "description": "Whether this coin should be blue or yellow.",
      "type": "bool",
      "default": "Yellow",
      "options": "coin_type"
    }
  }
}